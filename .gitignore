# ===========================================================================
# AI Browser Controller — .gitignore
# ===========================================================================

# --- Virtual environments --------------------------------------------------
venv/
.venv/
env/
ENV/

# --- Python bytecode / caches / build artifacts ----------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
build/
dist/
.coverage
htmlcov/

# --- Environment / secrets -------------------------------------------------
# Never commit real credentials. .env.example IS committed as a template.
.env
.env.*
!.env.example

# --- Runtime storage: keep every folder (via .gitkeep), never its contents --
# Covers screenshots/, recordings/, downloads/, sessions/, diffs/, memory/,
# workflows/, website_skills/ and the persistent browser profiles
# (browser_profile/, chrome_profile/, profiles/, active_profile.json), which
# hold cookies, session tokens and logged-in accounts. NEVER commit these.
app/storage/*
!app/storage/*/
app/storage/*/*
!app/storage/*/.gitkeep

# --- Generated captures / reports at the project root ----------------------
# Screenshots, videos, and JSON dumps produced by runs or demo scripts.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.webm
*.mkv
*.avi
admin_*.json
*_report.json
fun_fact*.*
admin_*.*

# --- Internal / working docs (NOT pushed to the public repo) ---------------
# README.md is intentionally kept and committed.
TASKS.md
NOTES.md
TODO.md
SCRATCH.md
CLAUDE.md
*.local.md

# --- Logs ------------------------------------------------------------------
*.log
logs/

# --- Editor / IDE / OS cruft -----------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
